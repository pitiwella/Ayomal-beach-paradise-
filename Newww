    <div class="modal-content">
        <h3 style="color:var(--gold); margin-bottom: 20px;">Bank Details</h3>
        <p><strong>Bank:</strong> People's Bank</p>
        <p><strong> Branch:</strong> Galle Fort<p><strong> 
Name:</strong> M.G. Dishani Surangika</p>
        <p><strong>Acc:</strong> 013200100045433</p>
        <button class="b-btn-main" style="width:100%; margin-top:20px;" onclick="sendWhatsApp()">Confirm on WhatsApp</button>
        <p onclick="closeModal()" style="margin-top:15px; cursor:pointer; text-decoration:underline;">Close</p>
    </div>
</div>

<footer><p>© 2026 Ayomal Beach Paradise | developed by Thisitha Prabodha</p></footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
<script>
    AOS.init({ duration: 1000, once: true });
    function openModal() { document.getElementById('bankModal').style.display = 'flex'; }
    function closeModal() { document.getElementById('bankModal').style.display = 'none'; }
    function openBooking() { window.open("https://www.booking.com/hotel/lk/ayomal-beach-paradise.html", "_blank"); }
    function sendWhatsApp() {
        const ci = document.getElementById('checkin').value || "TBD";
        const msg = `Hello! I'm interested in booking for ${ci}.`;
        window.open(`https://wa.me/94718208812?text=${encodeURIComponent(msg)}`, "_blank");
    }
</script>
</body>
</html>
